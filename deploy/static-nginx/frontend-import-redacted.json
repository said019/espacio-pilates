{
  "project": {
    "name": "espacio-pilates"
  },
  "resources": [
    {
      "address": "service.frontend",
      "type": "service",
      "name": "frontend",
      "engine": null,
      "variables": {
        "SERVE_MODE": {
          "type": "preserve"
        },
        "VITE_API_URL": {
          "type": "preserve"
        },
        "VITE_MP_PUBLIC_KEY": {
          "type": "preserve"
        }
      },
      "source": {
        "branch": "main",
        "checkSuites": false,
        "repo": "said019/espacio-pilates",
        "type": "github"
      },
      "build": {
        "buildEnvironment": "V3",
        "builder": "DOCKERFILE",
        "dockerfilePath": "deploy/static-nginx/Dockerfile"
      },
      "deploy": {
        "ipv6EgressEnabled": false,
        "multiRegionConfig": {
          "europe-west4-drams3a": {
            "numReplicas": 1
          }
        },
        "runtime": "V2",
        "startCommand": "/usr/local/bin/start-static-nginx",
        "useLegacyStacker": false
      },
      "networking": {
        "customDomains": {
          "www.tuespaciopilates.com.mx": {
            "port": 8080
          }
        },
        "serviceDomains": {
          "frontend-production-dcb15.up.railway.app": {}
        }
      },
      "volumeAttachments": null,
      "config": null,
      "groupId": null
    }
  ]
}
