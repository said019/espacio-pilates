{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/static-nginx/Dockerfile"
  },
  "deploy": {
    "startCommand": "/usr/local/bin/start-static-nginx",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
